{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nicewidgets.dev/nicepool/schemas/v1/nicepool-state.schema.json",
  "title": "NicePoolState v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layout", "activePlotIndex", "plots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "layout": { "enum": ["1x1", "1x2", "2x1", "2x2"] },
    "activePlotIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
    "plots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "plot-state.schema.json" }
    }
  }
}
