{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nicewidgets.dev/nicepool/schemas/v1/plot-state.schema.json",
  "title": "NicePool PlotState v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plotType", "preFilters", "xColumn", "yColumn", "groupColumn", "colorColumn", "useAbsoluteValue", "removeValuesThreshold", "swarmJitterAmount", "swarmGroupOffset", "jitterSeed", "histogramBins", "showRaw", "showMean", "showErrorBars", "errorBarType", "pointSize", "showLegend", "legendPosition", "showPlotlyToolbar", "showHover", "showAxes", "showHorizontalGrid", "showVerticalGrid", "cvEpsilon"],
  "properties": {
    "plotType": { "enum": ["scatter", "swarm", "box", "violin", "histogram", "cumulativeHistogram"] },
    "preFilters": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "xColumn": { "type": "string", "minLength": 1 },
    "yColumn": { "type": "string", "minLength": 1 },
    "groupColumn": { "type": ["string", "null"] },
    "colorColumn": { "type": ["string", "null"] },
    "useAbsoluteValue": { "type": "boolean" },
    "removeValuesThreshold": { "type": ["number", "null"], "minimum": 0 },
    "swarmJitterAmount": { "type": "number", "minimum": 0, "maximum": 2 },
    "swarmGroupOffset": { "type": "number", "minimum": 0, "maximum": 2 },
    "jitterSeed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "histogramBins": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
    "showRaw": { "type": "boolean" },
    "showMean": { "type": "boolean" },
    "showErrorBars": { "type": "boolean" },
    "errorBarType": { "enum": ["std", "sem"] },
    "pointSize": { "type": "integer", "minimum": 1, "maximum": 30 },
    "showLegend": { "type": "boolean" },
    "legendPosition": { "enum": ["bottom", "right", "top", "left"] },
    "showPlotlyToolbar": { "type": "boolean" },
    "showHover": { "type": "boolean", "default": false },
    "showAxes": { "type": "boolean" },
    "showHorizontalGrid": { "type": "boolean" },
    "showVerticalGrid": { "type": "boolean" },
    "cvEpsilon": { "type": "number", "minimum": 0 }
  }
}
